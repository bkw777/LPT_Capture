	)
	(text "DB25 LPT PRINTER INTERFACE\n\nDB25\n 1   ~{STROBE} - Computer pulses low when data ready.\n 2   PD0\n...\n 9   PD7\n10   ~{ACK} - Printer sets low to ack data read.\n11   BUSY - Printer sets high while busy.\n12   PE - Printer sets high on paper end.\n13   ONLINE - Printer sets high while on-line.\n14   ~{AUTOFD} or Supply GND - Computer sets low to request auto linefeed, or Power GND.\n15   ~{ERROR} - Printer sets low on error.\n16   ~{RESET} - Computer sets low to reset printer.\n17   ~{SELIN} - Computer sets low to select printer.\n18   SG\n...\n25   SG\nSH   Chassis Ground\n"
		(exclude_from_sim no)
		(at 16.256 193.294 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a87b2969-7cb5-47ba-a4cf-37db081c7dd2")
	)
	(text "USB-C Receptacle 16-pin mid-mount\n\nGSB1C4621DS2HR\nUSB4520-03-0-A\nUJ20-C-H-G-MSMT-5-P16-TR\n"
