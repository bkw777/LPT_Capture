	(text "DB25 backshell, snap-together\n\n956-025-010R031   grey\n956-025-010R011   black\n956-025-020R121   chrome (insulate pcb!)\nMHCCOV-25-SN-LG   grey\nMHCCOV-25-SN-BK   black\n618025214622      black\n"
