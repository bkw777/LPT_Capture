		(uuid "0b74c555-b5fa-4c27-b70f-c2406ac45abc")
	)
	(text "DB25 Male solder-cup\n\nFits 1.6mm PCB:\n  DB25P064TXLF\n  A-DS 25 LL/Z  - loose\n  DE25PNES  - tight, slide in from side\n  L717SDB25P\n  61802524823\n  2101-0180-03\n\nNeeds 1.2mm PCB:\n  171-025-103L001\n  MHDB25SP\n  DB25-PD\n  40-9725M"
		(exclude_from_sim no)
		(at 233.68 121.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
